# Copy this file to ".env" and uncomment what you need.
# Values here take priority over the settings saved in the interface.

# --- AI provider -------------------------------------------------------------
# openai | groq | openrouter | ollama | custom
# JARVIS_PROVIDER=groq
# JARVIS_MODEL=llama-3.3-70b-versatile
# JARVIS_BASE_URL=https://api.groq.com/openai/v1

# Provider API keys (only the one you use needs a value).
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# JARVIS_API_KEY=

# --- Assistant ---------------------------------------------------------------
# JARVIS_CITY=Dubai
# JARVIS_PORT=8000

# Extra folders JARVIS is allowed to read or write, separated by ';' on Windows.
# Your home folder and this project folder are always allowed.
# JARVIS_ALLOWED_ROOTS=C:\Users\you\Projects
